class Solution {
public:
    vector<int> leaders(vector<int>& nums) {
        vector<int> temp;
        int n = nums.size();
        int maxi = nums[n-1];
        temp.push_back(nums[n-1]);
        for(int i=n-2;i>=0;i--)
        {
            if(nums[i]>maxi)
            temp.push_back(nums[i]);
            maxi=nums[i];
        }
        reverse(temp.begin(),temp.end());
        return temp;
    }
};

